{
  "rules": {
    "grupos": {
      ".read": true,
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren(['nome', 'pontos'])",
        "nome": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "pontos": { ".validate": "newData.isNumber()" }
      }
    },
    "acertos": {
      ".read": true,
      ".write": "auth != null",
      "$grupo": {
        "$estacao": {
          ".write": "auth != null || (!data.exists() && root.child('grupos').child($grupo).exists())",
          ".validate": "newData.isNumber() && newData.val() <= now && $estacao.matches(/^[a-z0-9]{2,12}$/)"
        }
      }
    },
    "chegadas": {
      ".read": true,
      ".write": "auth != null",
      "$grupo": {
        ".write": "auth != null || (!data.exists() && root.child('grupos').child($grupo).exists())",
        ".validate": "newData.hasChildren(['em'])",
        "em": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "rota": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "tempo": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$outro": { ".validate": false }
      }
    },
    "conteudo": {
      ".read": true,
      ".write": "auth != null"
    },
    "cronometro": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
