{
  "rules": {
    "grupos": {
      ".read": true,
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren(['nome', 'pontos'])",
        "nome": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "pontos": { ".validate": "newData.isNumber()" }
      }
    },
    "conteudo": {
      ".read": true,
      ".write": "auth != null"
    },
    "cronometro": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
